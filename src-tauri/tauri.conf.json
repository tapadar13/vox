{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.1.0",
  "identifier": "com.tapadar.vox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "dashboard",
        "title": "Vox",
        "width": 413,
        "height": 520,
        "minWidth": 413,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 20
        }
      },
      {
        "label": "pill",
        "title": "Vox Dictation",
        "url": "index.html?window=pill",
        "width": 320,
        "height": 68,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 32
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tapadar13/vox/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MzhCNkRCMUI0Mzc2MEIKUldRTGRrTWIyN1k0WmFTTy9lTWlnd3NOVWxiSW5sYW14Wi9zcmlBYnQzUytXbkZ4WkhvWDBXblgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Private, local voice-to-text for macOS",
    "longDescription": "Vox turns speech into polished text locally and pastes it at the current cursor.",
    "copyright": "Copyright © 2026 Vox contributors",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
