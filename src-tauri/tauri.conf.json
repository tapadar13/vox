{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.1.0",
  "identifier": "com.vox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "dashboard",
        "title": "Vox",
        "width": 780,
        "height": 560,
        "minWidth": 680,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "pill",
        "title": "Vox Dictation",
        "url": "index.html?window=pill",
        "width": 360,
        "height": 104,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Private, local voice-to-text for macOS",
    "longDescription": "Vox turns speech into polished text locally and pastes it at the current cursor.",
    "copyright": "Copyright © 2026 Vox contributors",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
